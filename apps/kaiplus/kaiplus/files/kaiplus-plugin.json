{
  "schemaVersion": 1,
  "id": "kaiplus",
  "name": "KaiPlus",
  "icon": "logo.png",
  "staticRoot": "/usr/share/kaiplus",
  "desktop": {
    "mode": "iframe",
    "target": {
      "scheme": "http",
      "hostMode": "request-host",
      "port": {
        "default": 8189,
        "keys": {
          "uci": "kaiplus.@kaiplus[0].port"
        }
      },
      "path": "/apps/kaiplus/"
    },
    "access": {
      "scope": "lan",
      "blockedTitle": "请在局域网内打开酷友社AI",
      "blockedMessage": "酷友社AI运行在设备的独立服务端口，请连接设备所在局域网后再打开。"
    }
  },
  "standalone": {
    "basePath": "/apps/kaiplus/",
    "url": "/apps/kaiplus/",
    "externalOpen": {
      "enabled": true,
      "label": "在浏览器中打开酷友社AI"
    }
  },
  "config": {
    "providerOrder": ["uci"],
    "providers": {
      "uci": {
        "type": "uci"
      }
    }
  },
  "backend": {
    "type": "http",
    "scheme": "http",
    "host": "127.0.0.1",
    "portFromUci": "kaiplus.@kaiplus[0].port",
    "defaultPort": 8189,
    "upstreamBasePath": "/apps/kaiplus/",
    "apiPath": "api/",
    "pathMode": "preserve"
  },
  "window": {
    "width": 1180,
    "height": 760,
    "singleton": true
  },
  "capabilities": ["assistant", "chat"],
  "categories": ["other"]
}
