#!/bin/sh /etc/rc.common
# ============================================================
# PicoClaw 后台安装器（procd oneshot）
#
# LuCI 只负责写入 /tmp/picoclaw-install.args 并调用
# `/etc/init.d/picoclaw-installer start`，真正的下载/校验/替换
# 由 /usr/lib/picoclaw-install.sh 在后台完成，避免 uhttpd
# CGI 超时。
#
# 安装结果写入 /tmp/picoclaw-install.status 和
# /tmp/picoclaw-install.log，页面轮询读取。
# ============================================================

START=99
STOP=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/lib/picoclaw-install.sh
	# 不自动重启：安装器自己会把失败写进状态文件，页面负责提示重试
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
