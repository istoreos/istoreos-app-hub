#!/bin/sh /etc/rc.common
START=15
STOP=89
USE_PROCD=1
CONFIG=/etc/optimemachine/config.json
BIN=/usr/sbin/optimemachine_bin
# rc.common has parsed action before sourcing this script. A return in
# stop_service alone cannot stop rc.common's subsequent procd_kill.
case "$action" in
 stop|restart|reload|disable)
  if [ -f "$CONFIG" ]; then "$BIN" maintenance-check --config "$CONFIG" --phase "$action" >/dev/null || exit 1; fi
 ;;
esac
start_service() {
 "$BIN" initialize --config "$CONFIG" >/dev/null || return 1
 procd_open_instance
 procd_set_param command "$BIN" serve --config "$CONFIG"
 procd_set_param respawn 3600 5 0
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param file "$CONFIG"
 procd_close_instance
}
boot() {
 "$BIN" initialize --config "$CONFIG" >/dev/null || return 1
 # S15 is synchronous. No second rollback timer is introduced.
 "$BIN" boot-recover --config "$CONFIG" || logger -t optimemachine 'early recovery needs attention; inspect boot-status'
 start
}
